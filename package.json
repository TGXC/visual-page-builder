{
  "name": "visual-page-builder",
  "private": true,
  "version": "0.0.0",
  "description": "Studio：可视化页面搭建器（元素树 + 布局引擎 + 可控代码生成）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf": "node --require ./scripts/sandbox-shim.cjs ./node_modules/vitest/vitest.mjs run --config vitest.perf.config.ts",
    "test:smoke": "node --require ./scripts/sandbox-shim.cjs ./node_modules/vitest/vitest.mjs run --config vitest.smoke.config.ts",
    "coverage": "vitest run --coverage",
    "lint": "eslint ."
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "nanoid": "^6.0.2",
    "pinia": "^4.1.0",
    "vue": "^3.5.42",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
